layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab focus=true {
        pane stacked=true {
            pane command="nvim"
            pane command="claude" focus=true
            pane
            pane
        }
    }

    tab {
        pane stacked=true {
            pane command="claude" focus=true expanded=true
            pane
        }
    }

    tab {
        pane stacked=true {
            pane command="claude" focus=true expanded=true
            pane
        }
    }
}
