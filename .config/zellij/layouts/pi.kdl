layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab focus=true {
        pane stacked=true {
            pane command="nvim"
            pane command="pi" focus=true
        }
    }
}
