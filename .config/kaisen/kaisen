#!/usr/bin/env bash
set -euo pipefail

CMD_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/cmd"

usage() {
  echo "usage: ks <subcommand> [args...]"
  echo
  echo "subcommands:"
  if [[ -d $CMD_DIR ]]; then
    for f in "$CMD_DIR"/*; do
      [[ -f $f && -x $f ]] || continue
      printf '  %s\n' "$(basename "$f")"
    done
  fi
}

sub="${1:-}"
case "$sub" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;
esac
shift

script="$CMD_DIR/$sub"
if [[ ! -x $script ]]; then
  echo "ks: unknown subcommand: $sub" >&2
  usage >&2
  exit 1
fi

exec "$script" "$@"
