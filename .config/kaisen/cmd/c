#!/usr/bin/env bash
set -euo pipefail

# kaisen commit: forwards all args to `jj commit`, then creates a
# Graphite-style bookmark derived from the first line of the commit
# description, placed at the commit we just made (@-).

jj commit "$@"

subject=$(jj log -r @- --no-graph -T 'description.first_line()')

if [[ -z $subject ]]; then
  echo "ks c: empty commit message; skipping bookmark" >&2
  exit 0
fi

slug=$(printf '%s' "$subject" \
  | tr '[:upper:]' '[:lower:]' \
  | sed -E 's/[^a-z0-9]+/-/g; s/(^-+|-+$)//g')

if (( ${#slug} > 50 )); then
  slug=${slug:0:50}
  slug=${slug%-*}
fi
[[ -z $slug ]] && slug=wip

branch="${USER}/${slug}"

if ! jj bookmark create "$branch" -r @- 2>/dev/null; then
  suffix=$(jj log -r @- --no-graph -T 'change_id.shortest()')
  branch="${branch}-${suffix}"
  jj bookmark create "$branch" -r @-
fi

printf 'bookmark: %s @ %s\n' "$branch" "$(jj log -r @- --no-graph -T 'commit_id.short()')"
