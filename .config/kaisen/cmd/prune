#!/usr/bin/env bash
set -euo pipefail

# kaisen prune: forget local bookmarks that are either
#   (A) deleted on origin (no @origin tracking), or
#   (B) whose tip commit's author.email differs from jj config user.email.
#
# Uses `jj bookmark forget --include-remotes` — local-only, does NOT push
# deletions to the remote. Foreign remote bookmarks will re-appear on the
# next fetch if your `auto-track-bookmarks` glob includes them.
#
# Flags: -n/--dry-run to preview without making changes.

dry_run=false
for arg in "$@"; do
  case $arg in
    -n|--dry-run) dry_run=true ;;
    -h|--help)
      echo "usage: ks prune [-n|--dry-run]"
      exit 0
      ;;
    *)
      echo "ks prune: unknown arg: $arg" >&2
      exit 1
      ;;
  esac
done

# Accept multiple "this is me" emails. Defaults to jj user.email; extend by
# setting KAISEN_USER_EMAILS to a comma- or colon-separated list of extra
# addresses (e.g. noreply GitHub form, old personal email).
primary_email="$(jj config get user.email 2>/dev/null || true)"
if [[ -z $primary_email ]]; then
  echo "ks prune: could not read jj user.email" >&2
  exit 1
fi

extra_emails=()
if [[ -n ${KAISEN_USER_EMAILS:-} ]]; then
  IFS=':,' read -r -a extra_emails <<< "$KAISEN_USER_EMAILS"
fi
my_emails=("$primary_email" "${extra_emails[@]+"${extra_emails[@]}"}")

# Never prune trunk bookmarks — their tip author is whoever landed the last
# PR, which is rarely the current user. Override with KAISEN_PROTECTED.
default_protected="main,master,trunk,develop"
IFS=':,' read -r -a protected <<< "${KAISEN_PROTECTED:-$default_protected}"

is_protected() {
  local n="$1"
  for p in "${protected[@]}"; do
    [[ -n $p && $n == "$p" ]] && return 0
  done
  return 1
}

is_me() {
  local email="$1"
  for e in "${my_emails[@]}"; do
    [[ -n $e && $email == "$e" ]] && return 0
  done
  return 1
}

names=$(
  jj bookmark list --all-remotes -T '
    if(remote, "", name ++ "\n")
  ' | sort -u
)

if [[ -z $names ]]; then
  echo "no local bookmarks"
  exit 0
fi

pruned=0
kept=0

while IFS= read -r rawname; do
  [[ -z $rawname ]] && continue

  name="$rawname"
  if [[ $name == \"*\" ]]; then
    name="${name#\"}"
    name="${name%\"}"
  fi

  if is_protected "$name"; then
    kept=$((kept + 1))
    continue
  fi

  remote_rev=$(jj log --no-graph --ignore-working-copy \
    -r "present($rawname@origin)" -T 'commit_id' 2>/dev/null || true)

  author=$(jj log --no-graph --ignore-working-copy \
    -r "present($rawname)" -T 'author.email()' 2>/dev/null || true)

  reason=""
  if [[ -z $remote_rev ]]; then
    reason="deleted on remote"
  elif [[ -n $author ]] && ! is_me "$author"; then
    reason="authored by $author"
  fi

  if [[ -z $reason ]]; then
    kept=$((kept + 1))
    continue
  fi

  if $dry_run; then
    printf '  (dry-run) × %s — %s\n' "$name" "$reason"
    pruned=$((pruned + 1))
  elif jj bookmark forget --include-remotes "\"$name\"" >/dev/null 2>&1; then
    printf '  × %s — %s\n' "$name" "$reason"
    pruned=$((pruned + 1))
  else
    printf '  ! %s — forget failed\n' "$name" >&2
  fi
done <<< "$names"

if $dry_run; then
  printf 'bookmarks: %d would be forgotten, %d kept\n' "$pruned" "$kept"
else
  printf 'bookmarks: %d forgotten, %d kept\n' "$pruned" "$kept"
fi

# --- second pass: abandon mutable commits not authored by anyone in my
# emails, and not reachable from any remaining bookmark or @. The reachable
# filter keeps stacks intact even when a stack contains a foreign ancestor.

mine_revset="mine()"
for e in "${my_emails[@]}"; do
  [[ -n $e ]] || continue
  escaped=${e//\"/\\\"}
  mine_revset+=" | author_email(exact-i:\"$escaped\")"
done

cleanup_revset="mutable() ~ ($mine_revset) ~ ::(bookmarks() | @)"

cleanup_count=$(
  jj log --no-graph --ignore-working-copy \
    -r "$cleanup_revset" -T 'commit_id ++ "\n"' 2>/dev/null | wc -l | tr -d ' '
)

if [[ $cleanup_count == "0" ]]; then
  echo "revisions: nothing to abandon"
  exit 0
fi

if $dry_run; then
  printf 'revisions: %d would be abandoned\n' "$cleanup_count"
  jj log --no-graph --ignore-working-copy -r "$cleanup_revset" \
    -T '"  × " ++ commit_id.shortest(8) ++ "  " ++ author.email() ++ "  " ++ description.first_line() ++ "\n"' \
    2>/dev/null | head -20
  if (( cleanup_count > 20 )); then
    printf '  ... and %d more\n' $((cleanup_count - 20))
  fi
else
  jj abandon -r "$cleanup_revset" >/dev/null
  printf 'revisions: %d abandoned\n' "$cleanup_count"
fi
