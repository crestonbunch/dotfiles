{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-jj-log log-changes",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-jj-log log-prompt",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "jenkins@duolingo-plugins": true
  },
  "extraKnownMarketplaces": {
    "duolingo-plugins": {
      "source": {
        "source": "github",
        "repo": "duolingo/infra-ai-agent-skills"
      }
    }
  },
  "effortLevel": "medium",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "model": "sonnet"
}
