#!/usr/bin/env bash
# work          → list my open GitHub PRs, grouped by repo, newest repos first.
# work switch   → fzf picker that cd's to the repo, jj-edits the PR bookmark,
#                 and attaches/switches to a zellij session.
set -euo pipefail

case "${1:-}" in
  switch)
    shift
    exec work-switch "$@"
    ;;
  ""|list) ;;
  -h|--help)
    echo "usage: work [list|switch]"
    exit 0
    ;;
  *)
    echo "usage: work [list|switch]" >&2
    exit 2
    ;;
esac

if ! command -v gh >/dev/null 2>&1; then
  echo "error: gh CLI not found in PATH" >&2
  exit 1
fi
if ! command -v jq >/dev/null 2>&1; then
  echo "error: jq not found in PATH" >&2
  exit 1
fi

read -r -d '' QUERY <<'GRAPHQL' || true
query {
  search(query: "is:pr author:@me is:open archived:false", type: ISSUE, first: 100) {
    nodes {
      ... on PullRequest {
        number
        title
        url
        isDraft
        createdAt
        updatedAt
        reviewDecision
        mergeable
        author { login }
        repository { nameWithOwner }
        commits(last: 1) {
          nodes { commit { statusCheckRollup { state } } }
        }
      }
    }
  }
}
GRAPHQL

response=$(gh api graphql -f query="$QUERY")

# Follow-up: per PR, fetch required-check details plus review threads, latest
# reviews, and review requests so we can show comment / check / reviewer info.
prs_json=$(echo "$response" | jq -c '[.data.search.nodes[] | select(. != null and .number != null)]')

extras_query=$(echo "$prs_json" | jq -r '
  if length == 0 then "" else
    [ to_entries[] |
      (.value.repository.nameWithOwner | split("/")) as $on
      | "p\(.key):repository(owner:\"\($on[0])\",name:\"\($on[1])\"){pullRequest(number:\(.value.number)){commits(last:1){nodes{commit{statusCheckRollup{contexts(first:100){nodes{__typename ... on CheckRun{conclusion status isRequired(pullRequestNumber:\(.value.number))} ... on StatusContext{state isRequired(pullRequestNumber:\(.value.number))}}}}}}} reviewThreads(first:50){nodes{isResolved comments(last:1){nodes{author{login}}}}} latestReviews(first:30){nodes{author{login} state}} reviewRequests(first:30){nodes{requestedReviewer{__typename ... on User{login} ... on Team{slug}}}}}}"
    ] | "query{" + join(" ") + "}"
  end
')

if [ -n "$extras_query" ]; then
  extras_response=$(gh api graphql -f query="$extras_query" 2>/dev/null) || extras_response='{"data":{}}'
else
  extras_response='{"data":{}}'
fi

pr_extras=$(echo "$extras_response" | jq -c --argjson prs "$prs_json" '
  (.data // {}) as $data
  | $prs
  | to_entries
  | map(
      .key as $idx
      | .value as $pr
      | ($pr.author.login // "") as $author
      | ($data["p\($idx)"].pullRequest // {}) as $extra
      | {
          key: "p\($idx)",
          value: {
            failing_required: ([
              ($extra.commits.nodes[0].commit.statusCheckRollup.contexts.nodes // [])[]
              | select(.isRequired == true)
              | select(
                  (.__typename == "CheckRun" and (
                    .conclusion == "FAILURE" or .conclusion == "TIMED_OUT" or
                    .conclusion == "CANCELLED" or .conclusion == "ACTION_REQUIRED" or
                    .conclusion == "STARTUP_FAILURE"
                  )) or
                  (.__typename == "StatusContext" and (.state == "FAILURE" or .state == "ERROR"))
                )
            ] | length),
            pending_required: ([
              ($extra.commits.nodes[0].commit.statusCheckRollup.contexts.nodes // [])[]
              | select(.isRequired == true)
              | select(
                  (.__typename == "CheckRun" and (.status != "COMPLETED")) or
                  (.__typename == "StatusContext" and (.state == "PENDING" or .state == "EXPECTED"))
                )
            ] | length),
            unresolved_no_reply: ([
              ($extra.reviewThreads.nodes // [])[]
              | select(.isResolved != true)
              | (.comments.nodes // []) as $cs
              | select(($cs | length) > 0)
              | select(($cs[-1].author.login // "") != $author)
            ] | length),
            reviewers: (
              (
                ($extra.latestReviews.nodes // [])
                | map({
                    login: (.author.login // "?"),
                    state: (.state // "PENDING")
                  })
              ) +
              (
                ($extra.reviewRequests.nodes // [])
                | map({
                    login: (.requestedReviewer.login // .requestedReviewer.slug // "?"),
                    state: "PENDING"
                  })
              )
              | group_by(.login)
              | map(
                  (map(select(.state == "PENDING"))) as $pending
                  | if ($pending | length) > 0 then $pending[0] else .[0] end
                )
              | sort_by(.login)
            )
          }
        }
    )
  | from_entries
')
[ -z "$pr_extras" ] && pr_extras='{}'

# Bold-on / bold-off / dim / reset escape codes (only when stdout is a TTY).
if [ -t 1 ]; then
  B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'
else
  B=""; D=""; R=""
fi

echo "$prs_json" | jq -r --arg B "$B" --arg D "$D" --arg R "$R" --argjson extras "$pr_extras" '
  def age(created):
    ((now - (created | fromdateiso8601)) / 60) as $mins
    | if $mins < 60 then "\($mins | floor)m"
      elif $mins < 1440 then "\(($mins / 60) | floor)h"
      elif $mins < 10080 then "\(($mins / 1440) | floor)d"
      elif $mins < 525600 then "\(($mins / 10080) | floor)w"
      else "\(($mins / 525600) | floor)y"
      end;

  def state_emoji(s):
    if s == "APPROVED" then "✅"
    elif s == "CHANGES_REQUESTED" then "❌"
    elif s == "COMMENTED" then "❓"
    elif s == "DISMISSED" then "⊘"
    elif s == "PENDING" then "⏳"
    else "?"
    end;

  def emoji(pr; idx):
    ($extras["p\(idx)"] // {}) as $e
    | ($e.failing_required // 0) as $fail
    | ($e.pending_required // 0) as $pend
    | (($e.reviewers // []) | length) as $rev_count
    | pr.reviewDecision as $rd
    | if pr.isDraft then "📝"
      elif $fail > 0 then "🔴"
      elif $rev_count == 0 then "📤"
      elif $rd == "APPROVED" and $pend == 0 then "🟢"
      elif $rd == "APPROVED" then "❎"
      elif $rd == "CHANGES_REQUESTED" then "🔁"
      else "  "
      end;

  def info_line(idx):
    ($extras["p\(idx)"] // {}) as $e
    | [
        (if ($e.unresolved_no_reply // 0) > 0 then "💬 \($e.unresolved_no_reply)" else null end),
        (
          ($e.reviewers // []) as $rev
          | if ($rev | length) == 0 then "👥 no reviewers"
            else
              ($rev | length) as $total
              | (["APPROVED","CHANGES_REQUESTED","COMMENTED","DISMISSED","PENDING"]
                  | map(
                      . as $st
                      | ($rev | map(select(.state == $st)) | length) as $n
                      | select($n > 0)
                      | "\(state_emoji($st)) \($n)/\($total)"
                    )) as $parts
              | "👥 " + ($parts | join(" "))
            end
        )
      ] | map(select(. != null)) | join("  ");

  to_entries
  | map(.value + {_idx: .key})
  | group_by(.repository.nameWithOwner)
  | map({
      repo: .[0].repository.nameWithOwner,
      latest: (map(.updatedAt) | max),
      prs: (sort_by(.updatedAt) | reverse)
    })
  | sort_by(.latest) | reverse
  | .[]
  | "\($B)\(.repo)\($R)",
    (.prs[] | "  \(emoji(.; ._idx))  #\(.number) · \(age(.createdAt)) · \(.title)\n      \(info_line(._idx))\n      \($D)\(.url)\($R)"),
    ""
'
