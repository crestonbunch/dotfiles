#!/usr/bin/env bash
set -euo pipefail

# Draft a PR body, then open it in $EDITOR. Used by jj pr and jj stack.
# Usage: jj-pr-body <out-file> <revset> <diff-command> [args...]
# Pass an empty revset to omit PR-range commit descriptions.
# JJ_PR_MAX_DIFF_KB caps the inline diff (default 256); the full diff stays readable.
# JJ_AI_BACKEND, JJ_AI_MODEL, and JJ_PR_MODEL configure jj-ai-run.

out="${1:?usage: jj-pr-body <out-file> <revset> <diff-command> [args...]}"
revset="${2?missing revset (pass '' to skip)}"
shift 2
if (( $# == 0 )); then
  echo "missing diff command" >&2
  exit 1
fi

prompt_file="$HOME/.config/jj/PR_DESCRIBE_PROMPT.md"
if [[ ! -f $prompt_file ]]; then
  echo "missing prompt file: $prompt_file" >&2
  exit 1
fi

cap_kb="${JJ_PR_MAX_DIFF_KB:-256}"
if [[ ! $cap_kb =~ ^[1-9][0-9]{0,6}$ ]]; then
  echo "JJ_PR_MAX_DIFF_KB must be a positive integer of at most 7 digits" >&2
  exit 1
fi
diff_cap=$(( cap_kb * 1024 ))

context_dir=$(mktemp -d "${TMPDIR:-/tmp}/jj-pr-body.XXXXXX")
trap 'rm -rf -- "$context_dir"' EXIT
prompt_input="$context_dir/prompt.md"
full_diff="$context_dir/full.diff"

# Capture once, without a truncating pipeline that can hide command failures.
if ! "$@" > "$full_diff"; then
  echo "diff command failed; no draft generated" >&2
  exit 1
fi

if repo_root=$(jj root --ignore-working-copy 2>/dev/null); then
  vcs=jj
else
  vcs=git
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
fi

template_path=""
for candidate in \
  .github/PULL_REQUEST_TEMPLATE.md .github/pull_request_template.md \
  PULL_REQUEST_TEMPLATE.md pull_request_template.md \
  docs/PULL_REQUEST_TEMPLATE.md docs/pull_request_template.md; do
  if [[ -f "$repo_root/$candidate" ]]; then
    template_path="$repo_root/$candidate"
    break
  fi
done

revisions=""
if [[ -n $revset ]]; then
  revisions=$(jj log --no-graph --ignore-working-copy -r "($revset) & ~empty()" \
    -T 'change_id ++ "\n"')
fi

history_file="$context_dir/history.txt"
if [[ $vcs = jj ]]; then
  history_revset="ancestors(${revset:-@})"
  if ! jj log --no-graph --ignore-working-copy --color never \
    -r "$history_revset" --limit 20 \
    -T 'change_id.short() ++ " " ++ description.first_line() ++ "\n"' > "$history_file"; then
    echo "[Recent history unavailable.]" > "$history_file"
  fi
elif ! git log -20 --format='%h %s' > "$history_file" 2>/dev/null; then
  echo "[Recent history unavailable.]" > "$history_file"
fi

{
  cat "$prompt_file"
  echo

  for rule_name in prose pull-requests; do
    rule_file="$HOME/.agents/rules/personal/$rule_name.md"
    if [[ -f $rule_file ]]; then
      if [[ $rule_name = prose ]]; then
        printf '\n## Prose rules\n\n'
      else
        printf '\n## Pull request rules\n\n'
      fi
      cat "$rule_file"
      echo
    else
      printf 'warning: no %s rule at %s\n' "$rule_name" "$rule_file" >&2
    fi
  done

  printf '\n## Repository\n\nRoot: %s\nRevision range: %s\n' "$repo_root" "${revset:-not supplied}"

  if [[ -n $template_path ]]; then
    printf '\n## GitHub PR template\n\n'
    cat "$template_path"
    echo
  fi

  if [[ -n $revisions ]]; then
    printf '\n## Commits\n\n'
    while IFS= read -r rev; do
      [[ -n $rev ]] || continue
      printf '### Revision %s\n\n' "$rev"
      jj log --no-graph --ignore-working-copy -r "$rev" -T 'description'
      echo
    done <<< "$revisions"
  fi

  printf '\n## Recent history\n\n'
  cat "$history_file"
  printf '\n## Diff\n\n'
  head -c "$diff_cap" "$full_diff"
  echo
  if (( $(wc -c < "$full_diff") > diff_cap )); then
    printf '\n[Diff excerpt truncated at %sKB. Full diff: %s]\n' "$cap_kb" "$full_diff"
  fi
} > "$prompt_input"

# Claude needs access to the full diff outside the repo; Pi reads absolute paths.
read_dirs=("$context_dir")
jj-ai-run pr "$prompt_input" "$out" ${read_dirs[@]+"${read_dirs[@]}"}

"${EDITOR:-vi}" "$out"
if [[ ! -s $out ]]; then
  echo "empty description" >&2
  exit 1
fi
