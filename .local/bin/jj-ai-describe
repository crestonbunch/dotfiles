#!/usr/bin/env bash
set -euo pipefail

# Shared logic for jj cc / jj cd: draft a commit message from the jj diff,
# open it in $EDITOR, then apply it.
#
# Usage: jj-ai-describe {describe|commit}
#   describe: jj describe -m <msg>
#   commit:   jj commit -m <msg>
#
# Environment:
#   JJ_AI_BACKEND      pi, claude, or claude-code
#   JJ_AI_MODEL        model for all jj drafts
#   JJ_COMMIT_MODEL    model override for commit drafts

action="${1:?usage: jj-ai-describe [describe|commit]}"

diff=$(jj diff -r @ --git)
if [[ -z $diff ]]; then
  echo "no changes in @" >&2
  exit 1
fi

prompt_file=$(mktemp -t jj-ai-describe-prompt)
msg_file=$(mktemp -t jj-ai-describe-msg)
trap 'rm -f "$prompt_file" "$msg_file"' EXIT

{
cat <<'PROMPT'
Write a commit message for the following change. Follow these rules exactly:

FORMAT:
- First line: a short imperative summary of WHAT changed (70 chars maximum).
  Use a capitalized verb: "Add", "Fix", "Refactor", "Remove", etc.
  No trailing period.
- If the first line tells the whole story, stop there.
- Otherwise, add a blank line, then one or more paragraphs explaining
  WHY this change was made or HOW it works, but only if those details
  aren't obvious from the diff itself. Wrap every line at 80 characters.

CONTENT GUIDANCE:
- The first line is the most important part. It should be specific enough
  that someone scanning `jj log` can understand the change without
  reading the diff.
- Don't restate what the diff already shows ("change X from A to B in
  file F"). Instead, explain the motivation or the effect.
- Mention non-obvious side effects, tradeoffs, or constraints.
OUTPUT:
- Output ONLY the commit message. No markdown fences, no preamble.
PROMPT

echo
echo "## Diff"
echo
echo "$diff"
} > "$prompt_file"

jj-ai-run commit "$prompt_file" "$msg_file"

"${EDITOR:-vi}" "$msg_file"

if [[ ! -s $msg_file ]]; then
  echo "empty message, aborting" >&2
  exit 1
fi

msg="$(cat "$msg_file")"

if [[ "$action" = "describe" ]]; then
  jj describe -m "$msg"
elif [[ "$action" = "commit" ]]; then
  jj commit -m "$msg"
else
  echo "unknown action: $action" >&2
  exit 1
fi
