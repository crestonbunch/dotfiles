{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-terra",
    "defaultThinking": "low",
    "agentOverrides": {
      "delegate": { "disabled": true },
      "oracle": { "disabled": true },
      "claude-code": { "disabled": true },
      "claude-code-writer": { "disabled": true },
      "codex-exec": { "disabled": true },
      "codex-exec-writer": { "disabled": true },
      "cursor-agent": { "disabled": true },
      "cursor-agent-writer": { "disabled": true }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "openai-codex/gpt-5.6-luna",
        "openai-codex/gpt-5.6-terra",
        "openai-codex/gpt-5.6-sol"
      ],
      "agents": {
        "lookup": { "allow": ["openai-codex/gpt-5.6-luna"] },
        "scout": { "allow": ["openai-codex/gpt-5.6-terra"] },
        "collector": { "allow": ["openai-codex/gpt-5.6-terra"] },
        "researcher": { "allow": ["openai-codex/gpt-5.6-terra"] },
        "mechanical-editor": { "allow": ["openai-codex/gpt-5.6-terra"] },
        "worker": { "allow": ["openai-codex/gpt-5.6-sol"] },
        "validator": { "allow": ["openai-codex/gpt-5.6-terra"] },
        "reviewer": { "allow": ["openai-codex/gpt-5.6-sol"] }
      }
    }
  },
  "packages": [
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access"
  ]
}
